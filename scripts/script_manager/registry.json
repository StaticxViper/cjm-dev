{
  "version": 1,
  "ignore_paths": [
    "scripts/video_editing/deprecated/**",
    "helper_scripts/utils/update_manager/**",
    "helper_scripts/utils/logger/import_log_example.py",
    "scripts/script_manager/**"
  ],
  "discover_roots": ["scripts", "helper_scripts"],
  "sinks": {
    "artifact": "scripts.script_manager.sinks.artifact",
    "dashboard": "scripts.script_manager.sinks.dashboard",
    "property_portal": "scripts.script_manager.sinks.property_portal",
    "callback": "scripts.script_manager.sinks.callback",
    "email": "scripts.script_manager.sinks.email"
  },
  "scripts": [
    {
      "name": "leadgen",
      "description": "Local business lead generation (Google Places API or Playwright Maps)",
      "status": "active",
      "entry": {"type": "path", "path": "scripts/lead_automation/leadgen.py"},
      "cwd": "scripts/lead_automation",
      "interactive": true,
      "non_interactive_args": ["--defaults"],
      "help_supported": true,
      "env": {
        "required": [],
        "optional": ["GOOGLE_API_KEY", "APIFY_API_KEY", "MVLLC_LOGS_KEY", "CRM_MCP_VENTURE"],
        "conditional": [
          {"when_args_any": ["--output=dashboard", "--output=both"], "require": ["CRM_MCP_MV_LLC"]},
          {"when_args_any": ["--leadgen-type=api_manager"], "require": ["GOOGLE_API_KEY"]}
        ]
      },
      "needs_playwright": "conditional",
      "playwright_when_args_any": ["--leadgen-type=playwright"],
      "timeout_seconds": 14400,
      "outputs": ["scripts/lead_automation/*leads_output*.json", "logs/**"],
      "side_effects": ["external_api", "external_post"],
      "stateful_files": [
        "scripts/lead_automation/leadgen_search_history.json",
        "scripts/lead_automation/leadgen_settings.json"
      ],
      "ci_allowed": true,
      "tags": ["leads"],
      "docs": "documentation/scripts/leadgen.md",
      "menu": "leadgen"
    },
    {
      "name": "leadenrich",
      "ci_allowed": true,
      "description": "Facebook email enrichment for leads via Apify",
      "status": "active",
      "entry": {"type": "path", "path": "scripts/lead_automation/leadenrich.py"},
      "cwd": "scripts/lead_automation",
      "help_supported": true,
      "env": {
        "required": ["APIFY_API_KEY"],
        "optional": ["MVLLC_LOGS_KEY", "CRM_MCP_VENTURE"],
        "conditional": [
          {"when_args_any": ["--dashboard"], "require": ["CRM_MCP_MV_LLC"]}
        ]
      },
      "needs_playwright": false,
      "outputs": ["scripts/lead_automation/*leads_output*.json", "logs/**"],
      "side_effects": ["external_api", "external_post"],
      "tags": ["leads"],
      "docs": "documentation/scripts/leadenrich.md",
      "menu": "flags",
      "prompts": [
        {"arg": "--json-path", "prompt": "Leads JSON path", "kind": "str"},
        {"arg": "--output-path", "prompt": "Output JSON path", "kind": "str"},
        {"arg": "--limit", "prompt": "Max leads (0 = no limit)", "kind": "int"},
        {"arg": "--min-similarity", "prompt": "Minimum name similarity", "kind": "float"},
        {"arg": "--max-search-results", "prompt": "Facebook results per lead", "kind": "int"},
        {"arg": "--max-workers", "prompt": "Concurrent searches", "kind": "int"},
        {"arg": "--retry-all", "prompt": "Re-attempt leads already checked?", "kind": "bool"},
        {"arg": "--dry-run", "prompt": "Dry run?", "kind": "bool"},
        {"arg": "--dashboard", "prompt": "Upload enriched leads to the dashboard?", "kind": "bool"}
      ]
    },
