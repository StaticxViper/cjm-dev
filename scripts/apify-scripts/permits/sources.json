{
  "sources": [
    {
      "id": "chicago_building_permits",
      "name": "Chicago building permits",
      "category": "City building permits",
      "adapter": "open_data",
      "enabled": true,
      "status": "verified",
      "access": "public",
      "coverage": {"states": ["IL"], "counties": ["Cook"], "cities": ["Chicago"]},
      "endpoint": "https://data.cityofchicago.org/resource/ydr8-5enu.json",
      "url": "https://data.cityofchicago.org/resource/ydr8-5enu.json",
      "record_url": "https://data.cityofchicago.org/resource/ydr8-5enu.json?permit_={id}",
      "query": {
        "style": "socrata",
        "date_column": "issue_date",
        "extra_where": "",
        "text_columns": ["work_description", "permit_type", "work_type"]
      },
      "field_map": {
        "permit_id": "permit_",
        "issued_date": "issue_date",
        "description": "work_description",
        "value_usd": "reported_cost",
        "address": ["street_number", "street_direction", "street_name"],
        "lat": "latitude",
        "lng": "longitude"
      },
      "type_fields": ["permit_type", "work_type"],
      "contact_slots": 15,
      "constants": {"city": "Chicago", "state": "IL"},
      "rate_limit": {"min_delay_s": 2.0, "max_delay_s": 5.0, "max_requests_per_run": 3, "page_size": 50},
      "terms_checked": {
        "date": "2026-10-26",
        "note": "City of Chicago Data Portal SODA. robots.txt allows /resource/ for User-agent * with Crawl-delay 1. Public open data, not a certified permit record. Owner and contractor names are copied only from contact slots whose contact_N_type says owner or contractor."
      },
      "notes": "Verified 2026-10-26: a $limit=1 query ordered by issue_date returned permit_, issue_date, reported_cost, work_description, permit_type, work_type, latitude, and longitude, plus contact_1_type through contact_3_type. contact_15_type is a real column. The extract has no property ZIP, so zip is left blank. No contractor license column."
    },
